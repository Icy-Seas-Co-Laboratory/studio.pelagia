{
  "name": "pelagia-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hugo --minify --cleanDestinationDir",
    "export:setup": "playwright install chromium",
    "export:review": "node scripts/export-review.mjs --format both",
    "export:review:full": "node scripts/export-review.mjs --format both --layout full-page",
    "export:pdf": "node scripts/export-review.mjs --format pdf",
    "export:pptx": "node scripts/export-review.mjs --format pptx"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "playwright": "^1.55.0",
    "pptxgenjs": "^4.0.1"
  }
}
